# Konfigurasi lokal Docker Compose — JANGAN pernah di-commit, isinya kredensial
# lokal (DB_PASSWORD, dll). Copy dari .env.docker.example untuk mulai.
.env
.env.docker
.env.*.local

# Sertifikat TLS lokal (di-generate per instalasi toko lewat
# docker/nginx/generate-certs.sh) — beda-beda tiap toko (IP LAN beda-beda),
# jangan pernah ikut commit.
docker/nginx/certs/*.pem
docker/nginx/certs/*.key
docker/nginx/certs/*.crt

