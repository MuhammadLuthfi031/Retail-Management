# === Konfigurasi Docker Compose (bukan .env Laravel) ===
# Copy file ini menjadi .env di root project

UID=1000
GID=1000

APP_PORT=8080
# Port HTTPS. Default 8443 supaya tidak butuh privilege khusus di host mana
# pun. Untuk instalasi toko sungguhan (biar kasir tidak perlu ingat nomor
# port), boleh diubah jadi APP_PORT=80 dan APP_SSL_PORT=443 — asal port itu
# belum dipakai layanan lain di server toko.
APP_SSL_PORT=8443
VITE_PORT=5173
PMA_PORT=8081

DB_DATABASE=toko_db
DB_USERNAME=toko_user
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret
DB_PORT_HOST=3306
