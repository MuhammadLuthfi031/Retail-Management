# === Konfigurasi Docker Compose (bukan .env Laravel) ===
# Copy file ini menjadi .env di root project, lalu ISI kedua password di bawah.

UID=1000
GID=1000

APP_PORT=8080
# Port HTTPS. Default 8443 supaya tidak butuh privilege khusus di host mana
# pun. Untuk instalasi toko sungguhan (biar kasir tidak perlu ingat nomor
# port), boleh diubah jadi APP_PORT=80 dan APP_SSL_PORT=443 — asal port itu
# belum dipakai layanan lain di server toko.
APP_SSL_PORT=8443
VITE_PORT=5173
PMA_PORT=8081

DB_DATABASE=toko_db
DB_USERNAME=toko_user

# WAJIB DIISI — sengaja dikosongkan; docker compose menolak berjalan bila kosong.
# Pakai password acak panjang berisi huruf dan angka saja (hindari tanda $ # " \ agar
# tidak bermasalah di file ini). Contoh membuat di PowerShell (24 karakter):
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 24 | % {[char]$_})
# CATATAN: password hanya dipakai MySQL saat volume database PERTAMA kali dibuat.
# Mengubahnya setelah itu TIDAK mengubah password di database yang sudah ada;
# lihat PANDUAN-SETUP-TOKO.md bagian "Mengganti password database".
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Port MySQL di komputer server (terikat 127.0.0.1, tidak terbuka ke jaringan).
DB_PORT_HOST=3306

# Lokasi backup di komputer server. Default: folder "backups" di samping docker-compose.yml.
# Untuk salinan di luar komputer toko, arahkan ke disk eksternal / folder jaringan, mis:
#   BACKUP_HOST_PATH=E:/BackupToko
# Di Linux, folder harus sudah ada dan dimiliki UID di atas (mkdir backups).
# BACKUP_HOST_PATH=./backups
